<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="480.0" prefWidth="760.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.uam.edu.proyectonavegacion.controllers.LoginController">

    <left>
        <VBox alignment="CENTER" maxWidth="290.0" minWidth="290.0"
              prefWidth="290.0" spacing="18.0"
              style="-fx-background-color: #006e7a;">
            <padding>
                <Insets bottom="38.0" left="36.0" right="36.0" top="38.0"/>
            </padding>

            <StackPane maxHeight="104.0" maxWidth="104.0"
                       prefHeight="104.0" prefWidth="104.0"
                       style="-fx-background-color: white; -fx-background-radius: 18;">
                <ImageView fitHeight="82.0" fitWidth="105.0"
                           preserveRatio="true" StackPane.alignment="CENTER">
                    <image>
                        <Image url="@uam.png"/>
                    </image>
                </ImageView>
                <opaqueInsets>
                    <Insets/>
                </opaqueInsets>
                <VBox.margin>
                    <Insets/>
                </VBox.margin>
            </StackPane>

            <Label style="-fx-font-size: 16px; -fx-text-fill: #e0f4f4;"
                   text="Sistema de registro y consulta de clientes"
                   textAlignment="CENTER" wrapText="true">
                <font>
                    <Font name="System Bold" size="13.0"/>
                </font>
            </Label>

            <Region prefHeight="18.0"/>
        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER_LEFT" spacing="11.0"
              style="-fx-background-color: white;">
            <padding>
                <Insets bottom="42.0" left="54.0" right="54.0" top="42.0"/>
            </padding>

            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #007d89;"
                   text="INICIO DE SESIÓN"/>

            <Label style="-fx-font-size: 27px; -fx-font-weight: bold; -fx-text-fill: #193642;"
                   text="Bienvenido de nuevo" wrapText="true"/>

            <Label style="-fx-font-size: 13px; -fx-text-fill: #637b82;"
                   text="Ingresá tus credenciales para continuar." wrapText="true"/>

            <Region prefHeight="10.0"/>

            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #25434b;"
                   text="Usuario"/>

            <TextField fx:id="txtUsuario" prefHeight="42.0"
                       promptText="Usuario"
                       style="-fx-background-color: #f5f9fa; -fx-background-radius: 9; -fx-border-color: #d5e3e6; -fx-border-radius: 9; -fx-font-size: 14px; -fx-padding: 0 13; -fx-focus-color: #007d89; -fx-faint-focus-color: transparent;"/>

            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #25434b;"
                   text="Contraseña"/>

            <PasswordField fx:id="txtClave" prefHeight="42.0"
                           promptText="Contraseña"
                           style="-fx-background-color: #f5f9fa; -fx-background-radius: 9; -fx-border-color: #d5e3e6; -fx-border-radius: 9; -fx-font-size: 14px; -fx-padding: 0 13; -fx-focus-color: #007d89; -fx-faint-focus-color: transparent;"/>

            <Label fx:id="lblMensaje" minHeight="22.0"
                   style="-fx-font-size: 12px; -fx-font-weight: bold;"
                   textFill="#b42318"/>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Button fx:id="confirmarBoton" defaultButton="true"
                        onAction="#btnConfirmar" prefHeight="42.0"
                        style="-fx-background-color: #007d89; -fx-background-radius: 9; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white; -fx-cursor: hand;"
                        text="Iniciar sesión"/>

                <Button onAction="#btnSalir" prefHeight="42.0"
                        style="-fx-background-color: white; -fx-background-radius: 9; -fx-border-color: #c8dadd; -fx-border-radius: 9; -fx-font-size: 13px; -fx-text-fill: #25434b; -fx-cursor: hand;"
                        text="Salir"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>