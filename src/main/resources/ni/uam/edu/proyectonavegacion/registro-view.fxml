<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="600.0" prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f8fafc;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.uam.edu.proyectonavegacion.controllers.RegistroController">
    <top>
        <VBox BorderPane.alignment="CENTER">
            <children>
                <MenuBar>
                    <menus>
                        <Menu text="Archivo">
                            <items>
                                <MenuItem text="Nuevo registro" onAction="#limpiarFormulario"/>
                                <MenuItem text="Guardar" onAction="#guardarCliente"/>
                            </items>
                        </Menu>
                        <Menu text="Ayuda">
                            <items>
                                <MenuItem text="Acerca de"/>
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>
                <ToolBar style="-fx-background-color: #e2e8f0; -fx-padding: 6 12;">
                    <items>
                        <Button onAction="#guardarCliente"
                                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                                text="Guardar Cliente"/>
                        <Button onAction="#limpiarFormulario"
                                style="-fx-background-color: #94a3b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                                text="Limpiar"/>
                        <Separator orientation="VERTICAL"/>
                        <Button onAction="#seleccionarImagen"
                                style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                                text="Seleccionar Foto"/>
                    </items>
                </ToolBar>
            </children>
        </VBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" prefHeight="615.0" prefWidth="900.0" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <children>
                <Label text="Registro de Cliente" textFill="#1e3a8a">
                    <font>
                        <Font name="System Bold" size="26.0"/>
                    </font>
                </Label>

                <VBox prefHeight="447.0" prefWidth="840.0" spacing="18.0"
                      style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 12; -fx-background-radius: 12;">
                    <padding>
                        <Insets bottom="22.0" left="22.0" right="22.0" top="22.0"/>
                    </padding>
                    <children>
                        <GridPane hgap="20.0" vgap="18.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                            </columnConstraints>

                            <children>
                                <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <children>
                                        <Label text="Nombres:" textFill="#1f2937">
                                            <font>
                                                <Font name="System Bold" size="13.0"/>
                                            </font>
                                        </Label>
                                        <TextField fx:id="txtNombres" prefHeight="35.0" promptText="Ingrese nombres"/>
                                    </children>
                                </VBox>

                                <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <children>
                                        <Label text="Apellidos:" textFill="#1f2937">
                                            <font>
                                                <Font name="System Bold" size="13.0"/>
                                            </font>
                                        </Label>
                                        <TextField fx:id="txtApellidos" prefHeight="35.0"
                                                   promptText="Ingrese apellidos"/>
                                    </children>
                                </VBox>

                                <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <children>
                                        <Label text="Código:" textFill="#1f2937">
                                            <font>
                                                <Font name="System Bold" size="13.0"/>
                                            </font>
                                        </Label>
                                        <TextField fx:id="txtCodigo" prefHeight="35.0" promptText="Ingrese código"/>
                                    </children>
                                </VBox>

                                <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <children>
                                        <Label text="Tipo de cliente:" textFill="#1f2937">
                                            <font>
                                                <Font name="System Bold" size="13.0"/>
                                            </font>
                                        </Label>
                                        <ComboBox fx:id="cmbTipoCliente" prefHeight="35.0" prefWidth="9999.0"
                                                  promptText="Seleccione"/>
                                    </children>
                                </VBox>

                                <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <children>
                                        <Label text="Ciudad:" textFill="#1f2937">
                                            <font>
                                                <Font name="System Bold" size="13.0"/>
                                            </font>
                                        </Label>
                                        <TextField fx:id="txtCiudad" prefHeight="35.0" promptText="Ingrese ciudad"/>
                                    </children>
                                </VBox>

                                <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <children>
                                        <Label text="Fecha de nacimiento:" textFill="#1f2937">
                                            <font>
                                                <Font name="System Bold" size="13.0"/>
                                            </font>
                                        </Label>
                                        <DatePicker fx:id="dpFechaNacimiento" prefHeight="35.0" prefWidth="9999.0"
                                                    promptText="Seleccione fecha"/>
                                    </children>
                                </VBox>
                            </children>
                            <rowConstraints>
                                <RowConstraints/>
                                <RowConstraints/>
                                <RowConstraints/>
                            </rowConstraints>
                        </GridPane>

                        <VBox spacing="10.0">
                            <children>
                                <Label text="Tipo de solicitud:" textFill="#1f2937">
                                    <font>
                                        <Font name="System Bold" size="13.0"/>
                                    </font>
                                </Label>
                                <HBox spacing="18.0">
                                    <children>
                                        <RadioButton text="Normal">
                                            <toggleGroup>
                                                <ToggleGroup fx:id="tgTipoSolicitud"/>
                                            </toggleGroup>
                                        </RadioButton>
                                        <RadioButton text="Urgente" toggleGroup="$tgTipoSolicitud"/>
                                        <RadioButton text="Especial" toggleGroup="$tgTipoSolicitud"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <HBox alignment="CENTER_LEFT" spacing="18.0">
                            <children>
                                <CheckBox fx:id="chkServiciosInteres" text="Interés en servicios adicionales"
                                          textFill="#1f2937">
                                    <font>
                                        <Font size="13.0"/>
                                    </font>
                                </CheckBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <VBox alignment="CENTER" spacing="8.0">
                                    <children>
                                        <ImageView fx:id="imgFoto" fitHeight="120.0" fitWidth="120.0"
                                                   pickOnBounds="true" preserveRatio="true"
                                                   style="-fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-color: #f1f5f9;"/>
                                        <Button onAction="#seleccionarImagen"
                                                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                                                text="Agregar fotografía"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <HBox alignment="CENTER" spacing="18.0">
                    <children>
                        <Button onAction="#guardarCliente" prefHeight="38.0" prefWidth="180.0"
                                style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="Guardar Cliente"/>
                        <Button onAction="#limpiarFormulario" prefHeight="38.0" prefWidth="180.0"
                                style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="Limpiar formulario"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" prefHeight="10.0" prefWidth="864.0" spacing="600.0"
              style="-fx-background-color: #e2e8f0; -fx-padding: 8 18;" BorderPane.alignment="CENTER">
            <children>
                <Label text="Sistema de Registro | UAM" textFill="#475569">
                    <font>
                        <Font size="12.0"/>
                    </font>
                </Label>
                <Button mnemonicParsing="false" onAction="#volverAlMenu"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                        text="Volver al Menú"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>
