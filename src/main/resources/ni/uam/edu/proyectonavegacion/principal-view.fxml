<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Ventana Principal (Ventana 2) con MenuBar, ToolBar, Botones de función y ContextMenu -->

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0"
            prefWidth="700.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.uam.edu.proyectonavegacion.controllers.PrincipalController">
    <top>
        <VBox BorderPane.alignment="CENTER">
            <children>
                <!-- 1. MenuBar con opciones de navegación a Registro y Consulta -->
                <MenuBar>
                    <menus>
                        <Menu text="Archivo">
                            <items>
                                <MenuItem onAction="#abrirRegistro" text="Registro de Clientes"/>
                                <MenuItem onAction="#abrirConsulta" text="Consulta de Clientes"/>
                                <SeparatorMenuItem/>
                                <MenuItem onAction="#salir" text="Salir"/>
                            </items>
                        </Menu>
                        <Menu text="Ayuda">
                            <items>
                                <MenuItem onAction="#mostrarAcercaDe" text="Acerca de"/>
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>

                <!-- 2. ToolBar con botones de acceso directo a las principales funciones -->
                <ToolBar style="-fx-background-color: #e2e8f0; -fx-padding: 5 10;">
                    <items>
                        <Button mnemonicParsing="false" onAction="#abrirRegistro"
                                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                                text="Registro de Cliente"/>
                        <Button mnemonicParsing="false" onAction="#abrirConsulta"
                                style="-fx-background-color: #0d9488; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                                text="Consulta de Clientes"/>
                        <Separator orientation="VERTICAL"/>
                    </items>
                </ToolBar>
            </children>
        </VBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
            </padding>
            <children>
                <Label text="Bienvenido al Menú Principal" textFill="#1e3a8a">
                    <font>
                        <Font name="System Bold" size="26.0"/>
                    </font>
                </Label>
                <Label text="Seleccione una opción del menú, la barra de herramientas o los botones de acceso directo:"
                       textFill="#475569">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </Label>

                <!-- 3. Botones de acceso a las principales funciones en el centro de la pantalla -->
                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#abrirRegistro" prefHeight="50.0" prefWidth="210.0"
                                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="Registro de Cliente"/>
                        <Button mnemonicParsing="false" onAction="#abrirConsulta" prefHeight="50.0" prefWidth="210.0"
                                style="-fx-background-color: #0d9488; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="Consulta de Clientes"/>
                    </children>
                </HBox>

                <!-- 4. Panel central con ContextMenu para realizar acciones con la información mostrada -->
                <VBox alignment="CENTER" prefHeight="130.0" prefWidth="520.0"
                      style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-radius: 8;">
                    <children>
                        <Label text="Panel de Información General" textFill="#1e293b">
                            <font>
                                <Font name="System Bold" size="16.0"/>
                            </font>
                        </Label>
                        <Label fx:id="lblEstado"
                               text="Estado: Sistema listo. (Haga clic derecho sobre este recuadro para desplegar el ContextMenu)"
                               textAlignment="CENTER" textFill="#64748b" wrapText="true">
                            <font>
                                <Font size="13.0"/>
                            </font>
                            <VBox.margin>
                                <Insets top="10.0"/>
                            </VBox.margin>
                            <!-- Definición del ContextMenu para acciones sobre la información -->
                            <contextMenu>
                                <ContextMenu>
                                    <items>
                                        <MenuItem onAction="#mostrarInfoDetalle" text="Ver Detalles de Información"/>
                                    </items>
                                </ContextMenu>
                            </contextMenu>
                        </Label>
                    </children>
                    <VBox.margin>
                        <Insets top="20.0"/>
                    </VBox.margin>
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
                    </padding>
                </VBox>
            </children>
        </VBox>
    </center>
    <bottom>
        <HBox style="-fx-background-color: #e2e8f0; -fx-padding: 5 15;" BorderPane.alignment="CENTER">
            <children>
                <Label fx:id="lblStatusBar" text="Sistema de Navegación | UAM" textFill="#475569">
                    <font>
                        <Font size="12.0"/>
                    </font>
                </Label>
            </children>
        </HBox>
    </bottom>
</BorderPane>
